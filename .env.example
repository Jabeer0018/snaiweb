# Auth.js v5 secret (generate locally with: openssl rand -base64 32)
AUTH_SECRET=replace-with-random-32-byte-secret

# Google OAuth 2.0 (Google Cloud Console -> Web Application)
# Local callback:      http://localhost:3000/api/auth/callback/google
# Production callback: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple (Apple Developer Account -> Services ID + generated JWT client secret)
# Local callback:      https://your-https-tunnel-or-domain/api/auth/callback/apple
# Production callback: https://your-domain.vercel.app/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
